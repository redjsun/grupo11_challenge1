# Copie para .env e ajuste os valores: cp .env.example .env

# Banco de dados (usado pelos serviços db e api no compose)
POSTGRES_USER=fako
POSTGRES_PASSWORD=fako
POSTGRES_DB=fako

# Autenticação — gere um segredo forte, ex.: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=troque-este-segredo-em-producao
JWT_EXPIRES_MINUTES=1440

# Origens permitidas no CORS (lista JSON)
CORS_ORIGINS=["http://localhost:5173"]

# Inteligência Artificial: "fake" funciona sem chave; troque ao integrar um provedor real
AI_PROVIDER=fake
AI_API_KEY=
